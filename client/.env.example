# Copy this file to .env for local development.
# All VITE_ values are compiled into the browser bundle and are public.
# Do not use this setup for a real production secret.

VITE_USE_MOCK_API=true

VITE_API_BASE_URL=http://localhost:3000

# Local development credentials for the current Basic Auth setup.
# These are only for local testing.
VITE_API_USERNAME=<your-local-app-username>
VITE_API_PASSWORD=<your-local-app-password>